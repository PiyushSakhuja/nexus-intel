# URL where the backend is reachable. When the producer moves to its own
# device, this is the ONLY thing that needs to change (plus INGEST_SECRET_KEY
# below, which must always match the backend's .env value).
BACKEND_URL="http://localhost:4000"

# Must match INGEST_SECRET_KEY in the backend's .env exactly.
INGEST_SECRET_KEY="9e0ce7cba7d5c3b17dbb50fa50f990853cd629035e2cc0e2"

# How often (ms) to send the next staging-pool row.
PRODUCER_INTERVAL_MS=5000

# How many rows to generate per network when the staging pool is first
# built (or rebuilt after being drained).
ROWS_PER_NETWORK=5

# Where the local staging pool file lives. Defaults to ./staging-pool.json
# next to this script if unset.
# STAGING_POOL_PATH=./staging-pool.json
